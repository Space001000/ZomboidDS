<?xml version="1.0" encoding="utf-8"?>
<!-- The bridge speaks plain HTTP/WebSocket on the loopback interface only. Allow cleartext there
     (and to the emulator's alias for the host PC, for the mock server); everything else stays HTTPS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
